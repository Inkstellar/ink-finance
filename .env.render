# Render profile — point local dev at the DEPLOYED services instead of
# running the API server locally.
#
#   npm run render:status           # wake + health-check the three services
#   npm run dev:use-render-server   # Vite dev server -> Render API
#
# Secret-free, so it is committed on purpose. BOT_TOKEN / AI_API_KEY stay in
# gitignored .env.local and are layered underneath (see scripts/run-with-env.mjs,
# left-to-right, last file wins). Vite reaches the same result on its own:
# `--mode render` loads .env.render *after* .env / .env.local.
#
# NOTE: host root only, NO /api suffix — the frontend and bot already
# prepend /api themselves.

# Where the Vite dev proxy forwards /api. The SPA always calls /api
# same-origin (see vite.config.ts), which keeps the Auth.js session cookie
# first-party — onrender.com is on the Public Suffix List, so a direct
# cross-origin call would be a third-party cookie that Safari drops.
VITE_API_PROXY_TARGET=https://ink-finance-api.onrender.com

# Deployed API service, used by the Telegram bot (a server-to-server client
# with no browser and therefore no cookie).
VITE_API_URL=https://ink-finance-api.onrender.com

# Deployed frontend, used by the bot when it links back to the web app
WEB_URL=https://ink-finance-web.onrender.com

# Deployed bot — kept here so `npm run render:status` has a single source of
# truth. Local dev does NOT start a second bot: Telegram only allows one
# getUpdates poller per token, so a local bot would fight the deployed one.
BOT_URL=https://ink-finance-bot.onrender.com

# India is the only timezone this app thinks in — kept here so a local bot
# started against the deployed API still dates things in IST.
TZ=Asia/Kolkata
