{
  "name": "ink-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal finance manager — home finances, investments, and loans tracking.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run web\"",
    "web": "vite",
    "server": "npx tsx server/index.ts",
    "bot": "npx tsx telegram-bot/index.ts",
    "bot:watch": "tsx watch telegram-bot/index.ts",
    "dev:all": "concurrently -n api,web,bot -c blue,green,yellow \"npm run server\" \"npm run web\" \"npm run bot\"",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db execute --file prisma/seed.sql",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.7.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^4.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
