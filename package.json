{
  "name": "ink-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal finance manager — home finances, investments, and loans tracking.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run web\"",
    "dev:web": "npm run web",
    "web": "vite",
    "server": "npx tsx server/index.ts",
    "server:start": "node dist/server/index.js",
    "bot": "npx tsx telegram-bot/index.ts",
    "bot:start": "node dist/telegram-bot/index.js",
    "bot:watch": "tsx watch telegram-bot/index.ts",
    "dev:all": "concurrently -n api,web,bot -c blue,green,yellow \"npm run server\" \"npm run web\" \"npm run bot\"",
    "dev:use-render-server": "npm run web:render",
    "dev:use-render-server:with-bot": "concurrently -n web,bot -c green,yellow \"npm run web:render\" \"npm run bot:render\"",
    "web:render": "node scripts/run-with-env.mjs .env.render -- vite --mode render",
    "bot:render": "node scripts/run-with-env.mjs .env.local .env.render -- tsx telegram-bot/index.ts",
    "render:status": "node scripts/render-status.mjs",
    "user:set-password": "node scripts/set-password.mjs",
    "test:auth": "node scripts/auth-smoke.mjs",
    "test:loans": "node scripts/loans-smoke.mjs",
    "build": "prisma generate && tsc -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.json",
    "icons": "node scripts/generate-icons.mjs",
    "build:dev": "npx tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db execute --file prisma/seed.sql",
    "db:backup": "node scripts/db-backup.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:bot": "tsx scripts/bot-analytics.test.ts",
    "test:format": "tsx scripts/bot-format.test.ts",
    "test:scraper": "tsx scripts/wishlist-parse.test.ts",
    "test:tx": "node scripts/transactions-smoke.mjs",
    "test:avatar": "node scripts/avatar-smoke.mjs",
    "test:privacy": "node scripts/privacy-smoke.mjs",
    "test:deploy-paths": "node scripts/deploy-paths.test.mjs",
    "test:notify": "tsx scripts/notify.test.ts",
    "test:alerts": "node scripts/transaction-alert-smoke.mjs",
    "test:link": "tsx scripts/telegram-link.test.ts",
    "test:pwa": "node scripts/pwa.test.mjs",
    "test:calendar": "tsx scripts/calendar.test.ts",
    "test:events": "node scripts/events-smoke.mjs",
    "test:wishlist": "node scripts/wishlist-smoke.mjs",
    "test:backup": "node scripts/backup-format.test.mjs",
    "test:backup-restore": "node scripts/backup-roundtrip.mjs"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.7.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^4.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
