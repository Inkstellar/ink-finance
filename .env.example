# Example environment — copy to .env.local and fill in real values.
# Uses a dedicated ink_finance database on Neon, so `prisma db push`
# is safe to run without affecting other projects.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/ink_finance?sslmode=require"
API_PORT=3456
# Where the Vite dev proxy sends /api (the browser always calls /api
# same-origin, which is what keeps the session cookie first-party).
VITE_API_PROXY_TARGET=http://localhost:3456

# ── Auth.js (login for the web app) ─────────────────────────
# Session signing key — 32+ chars. `npx auth secret` or `openssl rand -hex 32`.
# Rotating it signs everyone out.
AUTH_SECRET=replace-me-with-a-long-random-string
# Behind Render's proxy Auth.js must trust forwarded host/proto headers.
AUTH_TRUST_HOST=true
# Shared secret the Telegram bot uses instead of a browser session
# (same value on the api and bot services). `openssl rand -hex 32`.
SERVICE_TOKEN=replace-me-with-a-long-random-string
# Origins permitted to call the API cross-origin. Normal traffic is
# same-origin, so this stays narrow. Comma-separated.
ALLOWED_ORIGINS=http://localhost:5179

# The app is single-timezone: India. Everything is denominated in INR
# (Prisma defaults + `formatINR` with the en-IN locale) and dated in IST.
# Pinning TZ makes local-time date maths IST by default — Render's servers run
# in UTC, so set TZ there too (api + bot services).
TZ=Asia/Kolkata

# Telegram Bot (create via @BotFather in Telegram)
BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs allowed to use the bot (empty = allow all)
BOT_ALLOWED_USERS=

# AI Vision API (OpenAI-compatible endpoint) for receipt analysis
AI_API_KEY=sk-your-key
AI_BASE_URL=https://router.bynara.id/v1
AI_MODEL=agnes-2.5-flash

# ── Creating logins ──────────────────────────────────────────────────────
# Passwords are never stored in env files. Set or reset one with:
#
#   npm run user:set-password
#   npm run user:set-password -- --email you@example.com --user K
#
# ── Developing against the deployed Render services ──────────────────────
# You don't need this file at all if you just want to run the local stack
# (`npm run dev`). When you DO want local dev pointed at the deployed API,
# the URLs live in the committed, secret-free `.env.render` profile and are
# layered on top of this file:
#
#   npm run render:status             # wake + health-check the Render services
#   npm run dev:use-render-server     # Vite dev server -> Render API (no local API)
#
# See README.md → "Develop against the deployed services".
