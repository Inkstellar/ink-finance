# Example environment — copy to .env.local and fill in real values.
# The DATABASE_URL points to the same Neon PostgreSQL instance used by
# puck-nextjs-starter. All ink-finance tables are prefixed with fin_ to
# avoid collisions.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
API_PORT=3456
VITE_API_URL=http://localhost:3456
