# Example environment — copy to .env.local and fill in real values.
# This points to the ink_finance database on the same Neon project
# as puck-nextjs-starter. It's a separate database, so it's safe to
# run `prisma db push` without affecting other projects.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/ink_finance?sslmode=require"
API_PORT=3456
VITE_API_URL=http://localhost:3456
